{
  "name": "illuminator",
  "productName": "Illuminator",
  "version": "0.7.61",
  "description": "Open, refocus and animate Lytro ILLUM and first generation light field photographs",
  "license": "PolyForm-Shield-1.0.0",
  "author": "AbstractPolygon, LLC",
  "homepage": "https://abstractpolygon.com",
  "desktopName": "illuminator.desktop",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "render": "node scripts/lfr-render.mjs",
    "dist": "electron-builder",
    "lint": "eslint .",
    "cli": "node scripts/illuminator.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.illuminator.app",
    "productName": "Illuminator",
    "copyright": "Copyright © AbstractPolygon, LLC",
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "lfr",
        "name": "Lytro ILLUM photo"
      },
      {
        "ext": "lfp",
        "name": "Lytro light field photo"
      }
    ],
    "afterPack": "build/mac-adhoc-sign.cjs",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "maintainer": "AbstractPolygon, LLC",
      "synopsis": "Lytro light field photo editor",
      "syncDesktopName": true,
      "vendor": "AbstractPolygon, LLC",
      "desktop": {
        "entry": {
          "Name": "Illuminator",
          "Comment": "Lytro light field photo editor",
          "Categories": "Graphics;Photography;"
        }
      }
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "dmg": {
      "title": "Illuminator ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "shortcutName": "Illuminator",
      "menuCategory": false
    },
    "artifactName": "Illuminator-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Illuminator"
    },
    "msiProjectCreated": "./build/msi-hook.cjs",
    "afterAllArtifactBuild": "./build/msi-finish.cjs"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.56.1"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0",
    "usb": "^2.19.2"
  }
}
